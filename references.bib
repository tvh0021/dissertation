@article{brown_gaia_2021,
	title = {Gaia {Early} {Data} {Release} 3 - {Summary} of the contents and survey properties},
	volume = {649},
	copyright = {© ESO 2021},
	issn = {0004-6361, 1432-0746},
	url = {https://www.aanda.org/articles/aa/abs/2021/05/aa39657-20/aa39657-20.html},
	doi = {10.1051/0004-6361/202039657},
	abstract = {{\textless}i{\textgreater}Context.{\textless}i/{\textgreater} We present the early installment of the third {\textless}i{\textgreater}Gaia{\textless}i/{\textgreater} data release, {\textless}i{\textgreater}Gaia{\textless}i/{\textgreater} EDR3, consisting of astrometry and photometry for 1.8 billion sources brighter than magnitude 21, complemented with the list of radial velocities from {\textless}i{\textgreater}Gaia{\textless}i/{\textgreater} DR2.{\textless}i{\textgreater}Aims.{\textless}i/{\textgreater} A summary of the contents of {\textless}i{\textgreater}Gaia{\textless}i/{\textgreater} EDR3 is presented, accompanied by a discussion on the differences with respect to {\textless}i{\textgreater}Gaia{\textless}i/{\textgreater} DR2 and an overview of the main limitations which are present in the survey. Recommendations are made on the responsible use of {\textless}i{\textgreater}Gaia{\textless}i/{\textgreater} EDR3 results.{\textless}i{\textgreater}Methods.{\textless}i/{\textgreater} The raw data collected with the {\textless}i{\textgreater}Gaia{\textless}i/{\textgreater} instruments during the first 34 months of the mission have been processed by the {\textless}i{\textgreater}Gaia{\textless}i/{\textgreater} Data Processing and Analysis Consortium and turned into this early third data release, which represents a major advance with respect to {\textless}i{\textgreater}Gaia{\textless}i/{\textgreater} DR2 in terms of astrometric and photometric precision, accuracy, and homogeneity. {\textless}i{\textgreater}Results. Gaia{\textless}i/{\textgreater} EDR3 contains celestial positions and the apparent brightness in {\textless}i{\textgreater}G{\textless}i/{\textgreater} for approximately 1.8 billion sources. For 1.5 billion of those sources, parallaxes, proper motions, and the ({\textless}i{\textgreater}G{\textless}i/{\textgreater}{\textless}sub{\textgreater}BP{\textless}sub/{\textgreater} − {\textless}i{\textgreater}G{\textless}i/{\textgreater}{\textless}sub{\textgreater}RP{\textless}sub/{\textgreater}) colour are also available. The passbands for {\textless}i{\textgreater}G{\textless}i/{\textgreater}, {\textless}i{\textgreater}G{\textless}i/{\textgreater}{\textless}sub{\textgreater}BP{\textless}sub/{\textgreater}, and {\textless}i{\textgreater}G{\textless}i/{\textgreater}{\textless}sub{\textgreater}RP{\textless}sub/{\textgreater} are provided as part of the release. For ease of use, the 7 million radial velocities from {\textless}i{\textgreater}Gaia{\textless}i/{\textgreater} DR2 are included in this release, after the removal of a small number of spurious values. New radial velocities will appear as part of {\textless}i{\textgreater}Gaia{\textless}i/{\textgreater} DR3. Finally, {\textless}i{\textgreater}Gaia{\textless}i/{\textgreater} EDR3 represents an updated materialisation of the celestial reference frame (CRF) in the optical, the {\textless}i{\textgreater}Gaia{\textless}i/{\textgreater}-CRF3, which is based solely on extragalactic sources. The creation of the source list for {\textless}i{\textgreater}Gaia{\textless}i/{\textgreater} EDR3 includes enhancements that make it more robust with respect to high proper motion stars, and the disturbing effects of spurious and partially resolved sources. The source list is largely the same as that for {\textless}i{\textgreater}Gaia{\textless}i/{\textgreater} DR2, but it does feature new sources and there are some notable changes. The source list will not change for {\textless}i{\textgreater}Gaia{\textless}i/{\textgreater} DR3.{\textless}i{\textgreater}Conclusions. Gaia{\textless}i/{\textgreater} EDR3 represents a significant advance over {\textless}i{\textgreater}Gaia{\textless}i/{\textgreater} DR2, with parallax precisions increased by 30 per cent, proper motion precisions increased by a factor of 2, and the systematic errors in the astrometry suppressed by 30–40\% for the parallaxes and by a factor {\textasciitilde}2.5 for the proper motions. The photometry also features increased precision, but above all much better homogeneity across colour, magnitude, and celestial position. A single passband for {\textless}i{\textgreater}G{\textless}i/{\textgreater}, {\textless}i{\textgreater}G{\textless}i/{\textgreater}{\textless}sub{\textgreater}BP{\textless}sub/{\textgreater}, and {\textless}i{\textgreater}G{\textless}i/{\textgreater}{\textless}sub{\textgreater}RP{\textless}sub/{\textgreater} is valid over the entire magnitude and colour range, with no systematics above the 1\% level},
	language = {en},
	urldate = {2025-03-09},
	journal = {Astronomy \& Astrophysics},
	publisher = {EDP Sciences},
	author = {Brown, A. G. A. and Vallenari, A. and Prusti, T. and Bruijne, J. H. J. de and Babusiaux, C. and Biermann, M. and Creevey, O. L. and Evans, D. W. and Eyer, L. and Hutton, A. and Jansen, F. and Jordi, C. and Klioner, S. A. and Lammers, U. and Lindegren, L. and Luri, X. and Mignard, F. and Panem, C. and Pourbaix, D. and Randich, S. and Sartoretti, P. and Soubiran, C. and Walton, N. A. and Arenou, F. and Bailer-Jones, C. a. L. and Bastian, U. and Cropper, M. and Drimmel, R. and Katz, D. and Lattanzi, M. G. and Leeuwen, F. van and Bakker, J. and Cacciari, C. and Castañeda, J. and Angeli, F. De and Ducourant, C. and Fabricius, C. and Fouesneau, M. and Frémat, Y. and Guerra, R. and Guerrier, A. and Guiraud, J. and Piccolo, A. Jean-Antoine and Masana, E. and Messineo, R. and Mowlavi, N. and Nicolas, C. and Nienartowicz, K. and Pailler, F. and Panuzzo, P. and Riclet, F. and Roux, W. and Seabroke, G. M. and Sordo, R. and Tanga, P. and Thévenin, F. and Gracia-Abril, G. and Portell, J. and Teyssier, D. and Altmann, M. and Andrae, R. and Bellas-Velidis, I. and Benson, K. and Berthier, J. and Blomme, R. and Brugaletta, E. and Burgess, P. W. and Busso, G. and Carry, B. and Cellino, A. and Cheek, N. and Clementini, G. and Damerdji, Y. and Davidson, M. and Delchambre, L. and Dell’Oro, A. and Fernández-Hernández, J. and Galluccio, L. and García-Lario, P. and Garcia-Reinaldos, M. and González-Núñez, J. and Gosset, E. and Haigron, R. and Halbwachs, J.-L. and Hambly, N. C. and Harrison, D. L. and Hatzidimitriou, D. and Heiter, U. and Hernández, J. and Hestroffer, D. and Hodgkin, S. T. and Holl, B. and Janßen, K. and Fombelle, G. Jevardat de and Jordan, S. and Krone-Martins, A. and Lanzafame, A. C. and Löffler, W. and Lorca, A. and Manteiga, M. and Marchal, O. and Marrese, P. M. and Moitinho, A. and Mora, A. and Muinonen, K. and Osborne, P. and Pancino, E. and Pauwels, T. and Petit, J.-M. and Recio-Blanco, A. and Richards, P. J. and Riello, M. and Rimoldini, L. and Robin, A. C