@article{hopkins_forged_2024,
	title = {{FORGE}'d in {FIRE}: {Resolving} the {End} of {Star} {Formation} and {Structure} of {AGN} {Accretion} {Disks} from {Cosmological} {Initial} {Conditions}},
	volume = {7},
	issn = {2565-6120},
	shorttitle = {{FORGE}'d in {FIRE}},
	url = {https://ui.adsabs.harvard.edu/abs/2024OJAp....7E..18H/abstract},
	doi = {10.21105/astro.2309.13115},
	abstract = {It has recently become possible to zoom-in from cosmological to sub-pc scales in galaxy simulations to follow accretion onto supermassive black holes (SMBHs). However, at some point the approximations used on ISM scales (e.g. optically-thin cooling and stellar-population-integrated star formation [SF] and feedback [FB]) break down. We therefore present the first cosmological radiation-magnetohydrodynamic (RMHD) simulation which self-consistently combines the FIRE physics (relevant on galactic/ISM scales where SF/FB are ensemble-averaged) and STARFORGE physics (relevant on small scales where we track individual (proto)stellar formation and evolution), together with explicit RMHD (including non-ideal MHD and multi-band M1-RHD) which self-consistently treats both optically-thick and thin regimes. This allows us to span scales from {\textasciitilde}100 Mpc down to \&lt;100 au ({\textasciitilde}300 Schwarzschild radii) around a SMBH at a time where it accretes as a bright quasar, in a single simulation. We show that accretion rates up to \${\textbackslash}sim 10-100{\textbackslash},\{{\textbackslash}rm M\_\{{\textbackslash}odot\}{\textbackslash},yr{\textasciicircum}\{-1\}\}\$ can be sustained into the accretion disk at \${\textbackslash}ll 10{\textasciicircum}\{3\}{\textbackslash},R\_\{{\textbackslash}rm schw\}\$, with gravitational torques between stars and gas dominating on sub-kpc scales until star formation is shut down on sub-pc scales by a combination of optical depth to cooling and strong magnetic fields. There is an intermediate-scale, flux-frozen disk which is gravitoturbulent and stabilized by magnetic pressure sustaining strong turbulence and inflow with persistent spiral modes. In this paper we focus on how gas gets into the small-scale disk, and how star formation is efficiently suppressed.},
	language = {en},
	urldate = {2025-04-18},
	journal = {The Open Journal of Astrophysics},
	author = {Hopkins, Philip F. and Grudic, Michael Y. and Su, Kung-Yi and Wellons, Sarah and Angles-Alcazar, Daniel and Steinwandel, Ulrich P. and Guszejnov, David and Murray, Norman and Faucher-Giguere, Claude-Andre and Quataert, Eliot and Keres, Dusan},
	month = mar,
	year = {2024},
	pages = {18},
}

@article{guo_magnetized_2024,
	title = {Magnetized {Accretion} onto and {Feedback} from {Supermassive} {Black} {Holes} in {Elliptical} {Galaxies}},
	volume = {973},
	issn = {0004-637X},
	url = {https://ui.adsabs.harvard.edu/abs/2024ApJ...973..141G/abstract},
	doi = {10.3847/1538-4357/ad5fe7},
	abstract = {We present 3D magnetohydrodynamic simulations of the fueling of supermassive black holes in elliptical galaxies from a turbulent cooling medium on galactic scales, taking M87* as a typical case. We find that the mass accretion rate is increased by a factor of ∼10 compared with analogous hydrodynamic simulations. The scaling of {\textless}inline-formula{\textgreater} {\textless}mml:math overflow="scroll"{\textgreater}{\textless}mml:mover accent="true"{\textgreater}{\textless}mml:mrow{\textgreater}{\textless}mml:mi{\textgreater}M{\textless}/mml:mi{\textgreater}{\textless}/mml:mrow{\textgreater}{\textless}mml:mrow{\textgreater}{\textless}mml:mo{\textgreater}̇{\textless}/mml:mo{\textgreater}{\textless}/mml:mrow{\textgreater}{\textless}/mml:mover{\textgreater}{\textless}mml:mo{\textgreater}∼{\textless}/mml:mo{\textgreater}{\textless}mml:msup{\textgreater}{\textless}mml:mrow{\textgreater}{\textless}mml:mi{\textgreater}r{\textless}/mml:mi{\textgreater}{\textless}/mml:mrow{\textgreater}{\textless}mml:mrow{\textgreater}{\textless}mml:mn{\textgreater}1{\textless}/mml:mn{\textgreater}{\textless}mml:mrow{\textgreater}{\textless}mml:mo stretchy="true"{\textgreater}/{\textless}/mml:mo{\textgreater}{\textless}/mml:mrow{\textgreater}{\textless}mml:mn{\textgreater}2{\textless}/mml:mn{\textgreater}{\textless}/mml:mrow{\textgreater}{\textless}/mml:msup{\textgreater}{\textless}/mml:math{\textgreater} {\textless}/inline-formula{\textgreater} roughly holds from ∼10 pc to ∼10{\textless}SUP{\textgreater}‑3{\textless}/SUP{\textgreater} pc (∼10 r {\textless}SUB{\textgreater}g{\textless}/SUB{\textgreater}) with the accretion rate through the event horizon being ∼10{\textless}SUP{\textgreater}‑2{\textless}/SUP{\textgreater} M {\textless}SUB{\textgreater}⊙{\textless}/SUB{\textgreater} yr{\textless}SUP{\textgreater}‑1{\textless}/SUP{\textgreater}. The accretion flow on scales ∼0.03–3 kpc takes the form of magnetized filaments. Within ∼30 pc, the cold gas circularizes, forming a highly magnetized (β ∼ 10{\textless}SUP{\textgreater}‑3{\textless}/SUP{\textgreater}) thick disk supported by a primarily toroidal magnetic field. The cold disk is truncated and transitions to a turbulent hot accretion flow at ∼0.3 pc (10{\textless}SUP{\textgreater}3{\textless}/SUP{\textgreater} r {\textless}SUB{\textgreater}g{\textless}/SUB{\textgreater}). There are strong outflows toward the poles driven by the magnetic field. The outflow energy flux increases with smaller accretor size, reaching ∼3 × 10{\textless}SUP{\textgreater}43{\textless}/SUP{\textgreater} erg s{\textless}SUP{\textgreater}‑1{\textless}/SUP{\textgreater} for r {\textless}SUB{\textgreater}in{\textless}/SUB{\textgreater} = 8 r {\textless}SUB{\textgreater}g{\textless}/SUB{\textgreater}; this corresponds to a nearly constant energy feedback efficiency of η ∼ 0.05–0.1 independent of accretor size. The feedback energy is enough to balance the total cooling of the M87/Virgo hot halo out to ∼50 kpc. The accreted magnetic flux at small radii is similar to that in magnetically arrested disk models, consistent with the formation of a powerful jet on horizon scales in M87. Our results motivate a subgrid model for accretion in lower-resolution simulations in which the hot gas accretion rate is suppressed relative to the Bondi rate by {\textless}inline-formula{\textgreater} {\textless}mml:math overflow="scroll"{\textgreater}{\textless}mml:mo{\textgreater}∼{\textless}/mml:mo{\textgreater}{\textless}mml:msup{\textgreater}{\textless}mml:mrow{\textgreater}{\textless}mml:mo stretchy="false"{\textgreater}({\textless}/mml:mo{\textgreater}{\textless}mml:mn{\textgreater}10{\textless}/mml:mn{\textgreater}{\textless}mml:mspace width="0.25em"{\textgreater}{\textless}/mml:mspace{\textgreater}{\textless}mml:msub{\textgreater}{\textless}mml:mi{\textgreater}r{\textless}/mml:mi{\textgreater}{\textless}mml:mi mathvariant="normal"{\textgreater}g{\textless}/mml:mi{\textgreater}{\textless}/mml:msub{\textgreater}{\textless}mml:mo stretchy="true"{\textgreater}/{\textless}/mml:mo{\textgreater}{\textless}mml:msub{\textgreater}{\textless}mml:mi{\textgreater}r{\textless}/mml:mi{\textgreater}{\textless}mml:mi mathvariant="normal"{\textgreater}B{\textless}/mml:mi{\textgreater}{\textless}/mml:msub{\textgreater}{\textless}mml:mo stretchy="false"{\textgreater}){\textless}/mml:mo{\textgreater}{\textless}/mml:mrow{\textgreater}{\textless}mml:mrow{\textgreater}{\textless}mml:mn{\textgreater}1{\textless}/mml:mn{\textgreater}{\textless}mml:mo stretchy="true"{\textgreater}/{\textless}/mml:mo{\textgreater}{\textless}mml:mn{\textgreater}2{\textless}/mml:mn{\textgreater}{\textless}/mml:mrow{\textgreater}{\textless}/mml:msup{\textgreater}{\textless}/mml:math{\textgreater} {\textless}/inline-formula{\textgreater}.},
	language = {en},
	number = {2},
	urldate = {2025-04-18},
	journal = {The Astrophysical Journal},
	author = {Guo, Minghao and Stone, James M. and Quataert, Eliot and Kim, Chang-Goo},
	month = oct,
	year = {2024},
	pages = {141},
}

@article{boselli_virgo_2019,
	title = {A {Virgo} {Environmental} {Survey} {Tracing} {Ionised} {Gas} {Emission} ({VESTIGE}) - {V}. {Properties} of the ionised gas filament of {M} 87},
	volume = {623},
	copyright = {© A. Boselli et al. 2019},
	issn = {0004-6361, 1432-0746},
	url = {https://www.aanda.org/articles/aa/abs/2019/03/aa34492-18/aa34492-18.html},
	doi = {10.1051/0004-6361/201834492},
	abstract = {We observed the giant elliptical galaxy M 87 during the Virgo Environmental Survey Tracing Galaxy Evolution (VESTIGE), a blind narrow-band H{\textless}i{\textgreater}α{\textless}i/{\textgreater}+[NII] imaging survey of the Virgo cluster carried out with MegaCam at the Canada French Hawaii Telescope (CFHT). The deep narrow-band image confirmed the presence of a filament of ionised gas extending up to ≃3 kpc in the north-western direction and ≃8 kpc to the southeast, with a couple of plumes of ionised gas, the weakest of which, at ≃18 kpc from the nucleus, was previously unknown. The analysis of deep optical images taken from the NGVS survey confirms that this gas filament is associated with dust seen in absorption which is now detected up to ≃2.4 kpc from the nucleus. We also analysed the physical and kinematical properties of the ionised gas filament using deep IFU MUSE data covering the central 4.8 × 4.8 kpc{\textless}sup{\textgreater}2{\textless}sup/{\textgreater} of the galaxy. The spectroscopic data confirm a perturbed kinematics of the ionised gas, with differences in velocity of ≃700–800 km s{\textless}sup{\textgreater}−1{\textless}sup/{\textgreater} on scales of ≲1 kpc. The analysis of 2D diagnostic diagrams and the observed relationship between the shock-sensitive [OI]/H{\textless}i{\textgreater}α{\textless}i/{\textgreater} line ratio and the velocity dispersion of the gas suggest that the gas is shock-ionised.},
	language = {en},
	urldate = {2025-04-16},
	journal = {Astronomy \& Astrophysics},
	publisher = {EDP Sciences},
	author = {Boselli, A. and Fossati, M. and Longobardi, A. and Consolandi, G. and Amram, P. and Sun, M. and Andreani, P. and Boquien, M. and Braine, J. and Combes, F. and Côté, P. and Cuillandre, J. C. and Duc, P. A. and Emsellem, E. and Ferrarese, L. and Gavazzi, G. and Gwyn, S. and Hensler, G. and Peng, E. W. and Plana, H. and Roediger, J. and Sanchez-Janssen, R. and Sarzi, M. and Serra, P. and Trinchieri, G.},
	month = mar,
	year = {2019},
	pages = {A52},
}

