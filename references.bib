@article{qian_studies_2018,
	title = {Studies of {Turbulence} {Dissipation} in the {Taurus} {Molecular} {Cloud} with {Core} {Velocity} {Dispersion}},
	volume = {864},
	issn = {0004-637X},
	url = {https://dx.doi.org/10.3847/1538-4357/aad780},
	doi = {10.3847/1538-4357/aad780},
	abstract = {Turbulence dissipation is an important process affecting the energy balance in molecular clouds, the birth place of stars. Previously, the rate of turbulence dissipation is often estimated with semi-analytic formulae from simulation. Recently, we developed a data analysis technique called core velocity dispersion, which, for the first time, provides direct measurements of the turbulence dissipation rate in Taurus, a star-forming cloud. The thus measured dissipation rate of is similar to those from dimensional analysis, and is also consistent with the previous energy injection rate based on molecular outflows and bubbles.},
	language = {en},
	number = {2},
	urldate = {2025-03-11},
	journal = {The Astrophysical Journal},
	publisher = {The American Astronomical Society},
	author = {Qian, Lei and Li, Di and Gao, Yang and Xu, Haitao and Pan, Zhichen},
	month = sep,
	year = {2018},
	keywords = {Astrophysics - Astrophysics of Galaxies, Astrophysics - Instrumentation and Methods for Astrophysics, ISM: clouds, ISM: individual objects: Taurus, ISM: molecules},
	pages = {116},
}

@article{sun_molecular_2022,
	title = {Molecular {Cloud} {Populations} in the {Context} of {Their} {Host} {Galaxy} {Environments}: {A} {Multiwavelength} {Perspective}},
	volume = {164},
	url = {https://doi.org/10.3847/1538-3881/ac74bd},
	doi = {10.3847/1538-3881/ac74bd},
	abstract = {We present a rich, multiwavelength, multiscale database built around the PHANGS-ALMA CO(2-1) survey and ancillary data. We use this database to present the distributions of molecular cloud populations and sub-galactic environments in 80 PHANGS galaxies, to characterize the relationship between population-averaged cloud properties and host galaxy properties, and to assess key timescales relevant to molecular cloud evolution and star formation. We further estimate a suite of important timescales from our multiwavelength measurements. The cloud-scale free-fall time and turbulence crossing time are approximately 5--20 Myr, comparable to previous cloud lifetime estimates.},
	journal = {The Astronomical Journal},
	author = {Sun, Jiayi and Leroy, Adam K. and Rosolowsky, Erik and Hughes, Annie and Schinnerer, Eva and Schruba, Andreas and Koch, Eric W. and others},
	month = jul,
	year = {2022},
	keywords = {Astrophysics - Astrophysics of Galaxies},
	pages = {43},
}

@article{zhou_kinematics_2022,
	title = {Kinematics of the molecular interstellar medium probed by {Gaia}: steep velocity dispersion–size relation, isotropic turbulence, and location-dependent energy dissipation},
	volume = {513},
	issn = {0035-8711},
	shorttitle = {Kinematics of the molecular interstellar medium probed by {Gaia}},
	url = {https://doi.org/10.1093/mnras/stac900},
	doi = {10.1093/mnras/stac900},
	abstract = {The evolution of the molecular interstellar medium is controlled by processes such as turbulence, gravity, stellar feedback, and Galactic shear. AL a part of the ISM-6D project, using Gaia astrometric measurements towards a sample of young stellar objects (YSOs), we study the morphology and kinematic structure of the associated molecular gas. We identify 150 YSO associations with distance \$d {\textbackslash}lesssim 3 {\textbackslash},{\textbackslash},{\textbackslash}rm kpc\$. The YSO associations are elongated, with a median aspect ratio of 1.97, and are oriented parallel to the disc mid-plane, with a median angle of 30°. The turbulence in the molecular clouds as probed by the YSOs is isotropic, and the velocity dispersions are related to the sizes by σv, 2D = 0.74 (r/pc)0.67 (km s−1) . The slope is on the steeper side, yet consistent with previous measurements. The energy dissipation rate of turbulence \${\textbackslash}dot\{{\textbackslash}epsilon \} = {\textbackslash}sigma \_\{v,\{{\textbackslash}rm 3D\}\}{\textasciicircum}3 /L\$ decreases with the Galactocentric distance, with a gradient of 0.2 \${\textbackslash}rm dex {\textbackslash},{\textbackslash}, kpc{\textasciicircum}\{-1\}\$, which can be explained if turbulence is driven by cloud collisions. In this scenario, the clouds located in the inner Galaxy have higher chances to accrete smaller clouds and are more turbulent. Although the density structures of the complexes are anisotropic, the turbulence is consistent with being isotropic. If the alignment between density structures and the Galactic-disc mid-plane is due to shear, we expect \$t\_\{{\textbackslash}rm cloud\} {\textbackslash}gtrsim t\_\{{\textbackslash}rm shear\}{\textbackslash}approx 30{\textbackslash},{\textbackslash}, {\textbackslash}rm Myr\$. This cloud lifetime is longer than the turbulence crossing time, and a continuous energy injection is required to maintain the turbulence.},
	number = {1},
	urldate = {2025-03-11},
	journal = {Monthly Notices of the Royal Astronomical Society},
	author = {Zhou, Ji-Xuan and Li, Guang-Xing and Chen, Bing-Qiu},
	month = jun,
	year = {2022},
	keywords = {Astrophysics - Astrophysics of Galaxies, Galaxies: ISM, ISM: kinematics and dynamics, ISM: structure, Physical data and processes: turbulence, Stars: formation},
	pages = {638--647},
}

